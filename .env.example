# App URL (must match public host)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173
OAUTH_STATE_SECRET=change-me-to-a-long-random-string

# Job discovery (optional — free boards work without these)
FIRECRAWL_API_KEY=
EXA_API_KEY=
BRIGHT_DATA_API_KEY=

# Contacts (optional free tier)
HUNTER_API_KEY=

# LLM via OpenRouter free pool
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-120b:free
OPENROUTER_HTTP_REFERER=http://127.0.0.1:5173
OPENROUTER_APP_TITLE=Vexa
OPENROUTER_MAX_TOKENS_DEFAULT=128
# VEXA_HEURISTIC_ONLY=true

# Optional cold email send from app
RESEND_API_KEY=
COLD_EMAIL_FROM=

# Real OAuth — see docs/OAUTH_SETUP.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Dev only: fake connect without OAuth apps
# ALLOW_DEMO_OAUTH=true
